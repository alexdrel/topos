{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current Test File",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--enable-source-maps",
        "--import",
        "@oxc-node/core/register",
        "--test",
        "--test-isolation=none",
        "${file}"
      ]
    },
    {
      "request": "launch",
      "name": "Launch Current Script",
      "type": "node",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": {},
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--enable-source-maps",
        "--import",
        "@oxc-node/core/register"
      ]
    },
    // Launch the Topos extension in a new Extension Development Host window.
    {
      "name": "Launch Topos Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "cwd": "${workspaceFolder}/vscode-topos",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-topos",
        "--disable-extensions",
        "${workspaceFolder}"
      ]
    }
  ]
}
